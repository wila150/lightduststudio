# Copy this file to .env and fill in real values before running `npm start`.

PORT=3000

# Session cookie signing secret — set this to a long random string.
SESSION_SECRET=change-this-to-a-long-random-string

# Admin account — created automatically on first run if no admin exists yet.
# Change the password here and restart the server before going live.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# SMTP settings for the contact form. If left blank, submitted messages are
# only logged to the server console instead of emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=hello@lightdustudio.com
