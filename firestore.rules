rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // superadmin 全站可讀寫；租戶成員只能讀寫自己租戶底下的資料
    // 後端目前都是用 Admin SDK 存取（天生繞過這份規則），這是資料庫層的第二道防線：
    // 就算哪支伺服器端程式碼漏寫了 tenantId 檢查，資料庫本身還是會擋下跨租戶存取
    match /tenants/{tenantId}/{document=**} {
      allow read, write: if request.auth != null &&
        (request.auth.token.role == 'superadmin' || request.auth.token.tenantId == tenantId);
    }

    match /tenants/{tenantId} {
      allow read, write: if request.auth != null &&
        (request.auth.token.role == 'superadmin' || request.auth.token.tenantId == tenantId);
    }

    // admins 只有 superadmin 能讀寫
    match /admins/{id} {
      allow read, write: if request.auth != null && request.auth.token.role == 'superadmin';
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
